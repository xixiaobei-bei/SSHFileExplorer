<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SSHFileExplorer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SSHFileExplorer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SSHFileExplorer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="TopCommandBarBorder" Grid.Row="0" Background="{ThemeResource SystemControlHighlightAccentBrush}" Padding="10">
            <CommandBar HorizontalAlignment="Left" Background="Transparent" DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="False" IsOpen="False">
                <AppBarButton x:Name="ConnectButton" Width="48" Icon="Add" Label="连接" Click="ShowConnectDialog_Click" ToolTipService.ToolTip="连接到SSH服务器"/>
                <AppBarSeparator />
                <AppBarButton x:Name="UploadButton" Width="48" Icon="Upload" Label="上传" Click="UploadButton_Click" ToolTipService.ToolTip="上传文件到服务器"/>
                <AppBarButton x:Name="DownloadButton" Width="48" Icon="Download" Label="下载" Click="DownloadButton_Click" ToolTipService.ToolTip="下载文件到本地"/>
                <AppBarButton x:Name="RenameButton" Width="48" Icon="Rename" Label="重命名" Click="RenameButton_Click" ToolTipService.ToolTip="重命名选中的文件或目录"/>
                <AppBarButton x:Name="DeleteButton" Width="48" Icon="Delete" Label="删除" Click="DeleteButton_Click" ToolTipService.ToolTip="删除选中的文件或目录"/>
            </CommandBar>
        </Border>
        <Grid Grid.Row="1" x:Name="WelcomeGrid" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="WelcomeTitle" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="点击左上方的“+”以开启你的SSH之旅！" FontSize="24" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" x:Name="MainGrid" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- 左侧树形侧边栏 -->
            <TreeView x:Name="DirectoryTree" Grid.Column="0"
                      AllowDrop="True"
                      DragOver="DirectoryTree_DragOver"
                      Drop="DirectoryTree_Drop"
                      ItemInvoked="DirectoryTree_ItemInvoked">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0">
                            <Image Source="{Binding Content.Icon}" Width="18" Height="18" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Content.Name}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="Transparent" Padding="8,10,8,6" HorizontalAlignment="Stretch" Tapped="AddressBarBorder_Tapped">
                    <Grid>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Margin="0" Padding="0">
                            <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
                        </ScrollViewer>
                        <TextBox x:Name="AddressBarTextBox"
                                 IsReadOnly="False"
                                 Text="/"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Stretch"
                                 Visibility="Collapsed"
                                 Margin="0"
                                 KeyDown="AddressBarTextBox_KeyDown"
                                 Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                 BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                 BorderThickness="1"
                                 Padding="8"
                                 CornerRadius="8" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" x:Name="FileBrowserBackground" Padding="10" CornerRadius="8">
                    <Border.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="FileBrowserBackgroundColor" Color="White"/>
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Dark">
                                    <SolidColorBrush x:Key="FileBrowserBackgroundColor" Color="#2D2D30"/>
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </Border.Resources>
                    <Border.Background>
                        <StaticResource ResourceKey="FileBrowserBackgroundColor"/>
                    </Border.Background>
                    <ListView x:Name="FileListView"
                              SelectionMode="Extended"
                              DoubleTapped="FileListView_DoubleTapped"
                              PreviewKeyDown="FileListView_PreviewKeyDown"
                              Background="Transparent"
                              BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FileItem">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Image Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>