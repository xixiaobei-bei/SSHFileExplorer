<ContentDialog
    x:Class="SSHFileExplorer.ConnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SSH 连接"
    PrimaryButtonText="连接"
    CloseButtonText="取消">
    <StackPanel Spacing="12" HorizontalAlignment="Center">
        <TextBox x:Name="HostTextBox" PlaceholderText="主机/IP" Width="240" HorizontalAlignment="Left"/>
        <TextBox x:Name="UserTextBox" PlaceholderText="用户名" Width="240" HorizontalAlignment="Left"/>
        <PasswordBox x:Name="PasswordBox" PlaceholderText="密码" Width="240" HorizontalAlignment="Left"/>
        <TextBox x:Name="PrivateKeyPathTextBox" PlaceholderText="私钥路径(可选)" Width="240" HorizontalAlignment="Left"/>
        <TextBox x:Name="PortTextBox" PlaceholderText="端口(默认22)" Width="240" HorizontalAlignment="Left" Text="22"/>
        <CheckBox x:Name="SaveCheckBox" Content="保存此连接" IsChecked="False" Width="240" HorizontalAlignment="Left"/>
        <TextBox x:Name="DisplayNameTextBox" PlaceholderText="名称(可选，用于保存时显示)" Width="240" HorizontalAlignment="Left" Visibility="Collapsed"/>
    </StackPanel>
</ContentDialog>